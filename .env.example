# Bu dosyayi .env olarak kopyala ve doldur. .env asla commit'lenmez.

# --- Veri koku -------------------------------------------------------------
# Tum agir veri (asset, model, render ciktisi, cache, DB) burada yasar.
# Harici disk degisirse SADECE bu satiri degistir.
OTOMASYON_DATA_ROOT=D:\otomasyon-data

# --- LLM (senaryo uretimi) -------------------------------------------------
ANTHROPIC_API_KEY=
SCRIPT_MODEL=claude-opus-5

# --- AI video (opsiyonel, sinirli kullanim) --------------------------------
# Bos birakilirsa hat tamamen asset-pack render'a duser ve $0 AI video harcar.
KLING_API_KEY=

# --- YouTube ---------------------------------------------------------------
# Google Cloud Console > OAuth 2.0 Client ID (Desktop app) JSON yolu
YT_CLIENT_SECRET_FILE=
# Kanal A (Bedtime, Made for Kids)
YT_CHANNEL_A_TOKEN_FILE=
# Kanal B (Story Time, MFK degil)
YT_CHANNEL_B_TOKEN_FILE=

# --- Butce kapisi ----------------------------------------------------------
# Video basi sert tavan (USD). Asilirsa AI video adimi atlanir.
BUDGET_MAX_USD_PER_VIDEO=4.00
# Aylik toplam tavan (USD). Asilirsa uretim tamamen durur.
BUDGET_MAX_USD_PER_MONTH=150.00

# --- Onay kapisi -----------------------------------------------------------
# true = hicbir video insan onayi olmadan yayinlanmaz. Uretimde ASLA false yapma.
REQUIRE_HUMAN_APPROVAL=true

# --- n8n -------------------------------------------------------------------
N8N_PORT=5678
N8N_HOST=127.0.0.1
